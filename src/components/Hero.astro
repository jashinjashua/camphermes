---
import { Image } from "astro:assets";
import figureImage from "../assets/hero/figure.png";
import ambientImage from "../assets/hero/ambient.jpg";

// Layered hero built from the original artwork, separated by pixel values:
// ambient background → volumetric beam → figure cutout (the beam shines
// through the gaps between feathers) → faint front haze → material-masked
// light passes (skin, wings, metal, laurel) → drifting dust.
---

<section id="home" class="hero">
  <Image
    src={ambientImage}
    alt=""
    class="hero-ambient"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero-inner container">
    <div class="hero-copy">
      <h1>Where Men are Forged</h1>
      <p class="hero-sub">
        Brutal training, high-quality meat, and a brotherhood of men pushing past their limits in
        nature.
      </p>
      <div class="hero-ctas">
        <a href="/rank/" class="btn btn-primary">Find your Hero Rank</a>
        <a href="#ranks" class="btn btn-ghost">See camp levels</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <img src="/hero/light-beam.jpg" alt="" class="beam beam-back" loading="eager" />
      <div class="fig">
        <Image
          src={figureImage}
          alt=""
          class="fig-img"
          widths={[480, 720, 1024]}
          sizes="(max-width: 860px) 90vw, 40vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="pass pass-skin"></div>
        <div class="pass pass-wings"></div>
        <div class="pass pass-metal"></div>
        <img src="/hero/glint.png" alt="" class="laurel-glint" loading="lazy" />
      </div>
      <img src="/hero/light-beam.jpg" alt="" class="beam beam-front" loading="lazy" />
      <img src="/hero/dust.png" alt="" class="dust" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-ambient {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    object-position: center 20%;
    /* Blurred into a color wash: the artwork echoes as depth, not a clone */
    filter: blur(42px) brightness(0.5) saturate(1.15);
    animation: kenburns 38s ease-in-out infinite alternate;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10, 11, 13, 0.88) 0%,
      rgba(10, 11, 13, 0.55) 45%,
      rgba(10, 11, 13, 0.1) 100%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-top: 72px;
  }

  .hero-sub {
    max-width: 480px;
    margin-top: 18px;
    color: #b9c0ca;
    font-size: 1.1rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* --- Layered artwork ---------------------------------------------------- */

  .hero-art {
    position: relative;
    height: min(84svh, 760px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .fig {
    position: relative;
    height: 100%;
    aspect-ratio: 1024 / 1536;
    z-index: 2;
    animation: figure-drift 16s ease-in-out infinite;
  }

  .fig-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 34px rgba(255, 138, 46, 0.18));
  }

  .beam {
    position: absolute;
    top: -14%;
    left: 50%;
    width: 165%;
    max-width: none;
    mix-blend-mode: screen;
    transform-origin: top center;
    pointer-events: none;
    /* Fade the plate's own edges so they never show as seams */
    mask-image: radial-gradient(ellipse 46% 46% at 50% 32%, black 52%, transparent 76%);
    -webkit-mask-image: radial-gradient(ellipse 46% 46% at 50% 32%, black 52%, transparent 76%);
  }

  .beam-back {
    z-index: 1;
    opacity: 0.95;
    animation: beam-sway 17s ease-in-out infinite;
  }

  .beam-front {
    z-index: 3;
    opacity: 0.22;
    animation: beam-sway 17s ease-in-out infinite reverse;
  }

  /* Material light passes: each is the beam texture (or artwork heat) let
     through only where that material's pixels are. */
  .pass {
    position: absolute;
    inset: 0;
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .pass-skin {
    mask-image: url("/hero/mask-skin.png");
    -webkit-mask-image: url("/hero/mask-skin.png");
    background-image: url("/hero/light-beam.jpg");
    background-size: 300% 200%;
    opacity: 0.5;
    animation: skin-crawl 13s ease-in-out infinite alternate;
  }

  .pass-wings {
    mask-image: url("/hero/mask-wings.png");
    -webkit-mask-image: url("/hero/mask-wings.png");
    background: #ff7a2a;
    mix-blend-mode: overlay;
    animation: wing-ember 9s ease-in-out infinite;
  }

  .pass-metal {
    mask-image: url("/hero/mask-metal.png");
    -webkit-mask-image: url("/hero/mask-metal.png");
    background-image: url("/hero/light-beam.jpg");
    background-size: 340% 260%;
    opacity: 0;
    animation: metal-glint 14s ease-in-out infinite;
  }

  .laurel-glint {
    position: absolute;
    top: 4.2%;
    left: 57%;
    width: 13%;
    mix-blend-mode: screen;
    opacity: 0;
    animation: laurel-ping 9s ease-in-out infinite;
  }

  .dust {
    position: absolute;
    bottom: -6%;
    left: 12%;
    width: 76%;
    max-width: none;
    z-index: 4;
    mix-blend-mode: screen;
    opacity: 0.5;
    animation: dust-drift 46s linear infinite;
    pointer-events: none;
  }

  /* --- Motion --------------------------------------------------------------- */

  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }

  @keyframes figure-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes beam-sway {
    0%,
    100% {
      transform: translateX(-50%) rotate(-1.6deg);
      opacity: 0.8;
    }
    50% {
      transform: translateX(-50%) rotate(1.6deg);
      opacity: 1;
    }
  }

  @keyframes skin-crawl {
    from {
      background-position: 18% 0%;
    }
    to {
      background-position: 82% 30%;
    }
  }

  @keyframes wing-ember {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.55;
    }
  }

  @keyframes metal-glint {
    0%,
    76%,
    100% {
      opacity: 0;
    }
    82% {
      opacity: 0.75;
      background-position: 30% 20%;
    }
    90% {
      opacity: 0;
      background-position: 70% 45%;
    }
  }

  @keyframes laurel-ping {
    0%,
    82%,
    100% {
      opacity: 0;
      transform: scale(0.6);
    }
    88% {
      opacity: 0.9;
      transform: scale(1);
    }
    94% {
      opacity: 0;
      transform: scale(1.15);
    }
  }

  @keyframes dust-drift {
    from {
      transform: translateY(4%);
    }
    to {
      transform: translateY(-10%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ambient,
    .fig,
    .beam-back,
    .beam-front,
    .pass,
    .laurel-glint,
    .dust {
      animation: none;
    }
    .laurel-glint {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .hero {
      align-items: flex-end;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      padding-top: 76px;
      gap: 0;
    }

    .hero-art {
      order: -1;
      height: min(52svh, 480px);
    }

    .hero::after {
      background: linear-gradient(
        to bottom,
        rgba(10, 11, 13, 0.35) 0%,
        rgba(10, 11, 13, 0.2) 45%,
        rgba(10, 11, 13, 0.92) 100%
      );
    }

    .hero-copy {
      padding-bottom: 36px;
    }
  }
</style>
