---
import HeroFigure from "./HeroFigure.astro";
---

<section id="home" class="hero">
  <div class="hero-scene" aria-hidden="true"></div>
  <div class="hero-inner container">
    <div class="hero-copy">
      <h1>Where Men are Forged</h1>
      <p class="hero-sub">
        Brutal training, high-quality meat, and a brotherhood of men pushing past their limits in
        nature.
      </p>
      <div class="hero-ctas">
        <a href="/rank/" class="btn btn-primary">Find your Hero Rank</a>
        <a href="#ranks" class="btn btn-ghost">See camp levels</a>
      </div>
    </div>
    <div class="hero-art">
      <HeroFigure />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 68% 42%, rgba(192, 133, 82, 0.14), transparent 70%),
      linear-gradient(to bottom, rgba(18, 20, 26, 0.6), var(--bg));
  }

  .hero-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(236, 238, 241, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(236, 238, 241, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 40%, black 20%, transparent 75%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 24px;
    width: 100%;
    padding-top: 96px;
    padding-bottom: 48px;
  }

  .hero-sub {
    max-width: 480px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-art {
    min-width: 0;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 84px;
    }

    .hero-art {
      order: -1;
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
