---
import { Image } from "astro:assets";
import heroImage from "../assets/site/img-01.jpg";
---

<section id="home" class="hero">
  <Image
    src={heroImage}
    alt=""
    class="hero-media"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-fade"></div>
  <div class="hero-content container">
    <h1>Where Men are Forged</h1>
    <p class="hero-sub">
      Brutal training, high-quality meat, and a brotherhood of men pushing past their limits in
      nature.
    </p>
    <div class="hero-ctas">
      <a href="/rank/" class="btn btn-primary">Find your Hero Rank</a>
      <a href="#ranks" class="btn btn-ghost">See camp levels</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(10, 11, 13, 0.55) 0%, rgba(10, 11, 13, 0.15) 40%, rgba(10, 11, 13, 0.92) 100%);
  }

  .hero-content {
    position: relative;
    width: 100%;
    padding-bottom: 72px;
  }

  .hero-sub {
    max-width: 520px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
