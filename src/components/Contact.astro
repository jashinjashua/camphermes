---
const subjects = ["Camp Application", "Fee Information", "Training", "Food", "Transportation"];
---

<section class="section" id="contact">
  <div class="container">
    <div class="section-header reveal">
      <h2>Contact Hermes</h2>
      <p class="lead">Ready to apply or ask a question? Send a message.</p>
    </div>

    <div class="contact-grid reveal">
      <form id="contact-form" class="contact-form" novalidate>
        <div class="hp-field" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <label class="field">
          <span>Name</span>
          <input
            type="text"
            name="from_name"
            placeholder="Your name"
            required
            minlength="2"
            maxlength="50"
          />
        </label>
        <label class="field">
          <span>Email</span>
          <input type="email" name="from_email" placeholder="you@email.com" required />
        </label>
        <label class="field">
          <span>Subject</span>
          <select name="subject" required>
            <option value="" disabled selected hidden>Choose a subject</option>
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <label class="field">
          <span>Message</span>
          <textarea
            rows="6"
            name="message"
            placeholder="Tell us about yourself and the level you want"
            required></textarea>
        </label>
        <button type="submit" class="btn btn-primary" id="contact-submit">Send message</button>
        <p class="form-status" id="contact-status" role="status"></p>
      </form>

      <div class="contact-aside">
        <div class="map-wrap">
          <iframe
            title="Camp Hermes location"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d43991.35781456827!2d47.77150410258561!3d40.97607106103804!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4038488670692307%3A0x58abd44915c9b8ac!2sKebele%2C%20Azerbaycan!5e1!3m2!1str!2sus!4v1745830060779!5m2!1str!2sus"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <address>Kebele<br />Azerbaycan</address>
        <ul class="contact-links">
          <li>
            <a href="https://wa.me/905076647755" target="_blank" rel="noopener">
              WhatsApp: +90 507 664 77 55
            </a>
          </li>
          <li>
            <a href="mailto:jashin.jashua@gmail.com">Email: jashin.jashua@gmail.com</a>
          </li>
        </ul>
        <ul class="social-links">
          <li>
            <a href="https://facebook.com/orhan.mirza" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.3-.04-1.3-.13-2.45-.13-2.4 0-4.05 1.47-4.05 4.17v2.33H7.5V13h2.7v8h3.3z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://x.com/JashinJashua" aria-label="X" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.7 3H20l-6.5 7.4L21 21h-5.9l-4.6-6-5.3 6H3l7-7.9L3.5 3h6l4.1 5.5L17.7 3zm-1 16.2h1.6L7.4 4.7H5.7l11 14.5z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://instagram.com/jashin_joshua/" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@jashinway178/videos" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12s0-3.3-.4-4.8c-.2-.85-.9-1.5-1.7-1.7C18.3 5 12 5 12 5s-6.3 0-7.9.5c-.8.2-1.5.85-1.7 1.7C2 8.7 2 12 2 12s0 3.3.4 4.8c.2.85.9 1.5 1.7 1.7 1.6.5 7.9.5 7.9.5s6.3 0 7.9-.5c-.8-.2 1.5-.85 1.7-1.7.4-1.5.4-4.8.4-4.8zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 44px;
  }

  .contact-form {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field span {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .field input,
  .field select,
  .field textarea {
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px 14px;
  }

  .field textarea {
    resize: vertical;
  }

  .form-status {
    min-height: 1.4em;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .form-status.is-error {
    color: var(--accent);
  }

  .map-wrap iframe {
    width: 100%;
    height: 240px;
    border: 0;
    border-radius: 6px;
    filter: grayscale(1) invert(0.9);
  }

  address {
    font-style: normal;
    color: var(--muted);
    margin: 16px 0;
  }

  .contact-links {
    list-style: none;
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
  }

  .contact-links a {
    color: var(--text);
    text-decoration: none;
  }

  .contact-links a:hover {
    color: var(--accent);
  }

  .social-links {
    list-style: none;
    display: flex;
    gap: 14px;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--muted);
  }

  .social-links a:hover {
    color: var(--text);
    border-color: var(--text);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import emailjs from "@emailjs/browser";

  function initContact() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("contact-status");
    const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;
    if (!form || !status || !submit || form.dataset.bound) return;
    form.dataset.bound = "true";

    emailjs.init("OOUVhHMJ9FEi6VxCT");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get("website")) return; // Honeypot: silently drop bot submissions.

      status.classList.remove("is-error");
      status.textContent = "Sending…";
      submit.disabled = true;
      try {
        await emailjs.send("service_x1omsib", "template_fswwt17", {
          user_name: String(data.get("from_name") ?? ""),
          user_email: String(data.get("from_email") ?? ""),
          subject: String(data.get("subject") ?? ""),
          message: String(data.get("message") ?? ""),
        });
        status.textContent = "Message sent successfully!";
        form.reset();
      } catch (error) {
        status.classList.add("is-error");
        status.textContent = "Failed to send message. Please try again.";
        console.error("Error:", error);
      } finally {
        submit.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", initContact);
</script>
