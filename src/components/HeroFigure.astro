---
// Hand-authored geometric hero figure: winged athlete silhouette with
// dumbbells, statue-lit. Feathers are one primitive reused with transforms;
// the shimmer is a gradient band swept through a clip over the figure.

// Right wing fans from a wrist point above the shoulder. Angles are SVG
// rotations (y-down): 0 points right, negative lifts the feather. Primaries
// (low, pointing out) are longest; length tapers as the fan rises so the
// wing outline reads as an ellipse, not a sunburst.
const TIERS = [
  { count: 9, scale: 2.9, spread: 58, start: 6, base: 34, taper: 0.45, opacity: 1 },
  { count: 7, scale: 1.9, spread: 52, start: 10, base: 22, taper: 0.4, opacity: 0.75 },
  { count: 5, scale: 1.15, spread: 46, start: 14, base: 12, taper: 0.35, opacity: 0.5 },
];
---

<svg
  class="hero-figure"
  viewBox="40 60 720 560"
  role="img"
  aria-label="Winged athlete holding dumbbells"
>
  <defs>
    <linearGradient id="hf-bronze" x1="0" y1="0" x2="1" y2="0.35">
      <stop offset="0" stop-color="#e8b54a" />
      <stop offset="0.55" stop-color="#b07b46" />
      <stop offset="1" stop-color="#5f4128" />
    </linearGradient>
    <linearGradient id="hf-marble" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#59627a" />
      <stop offset="0.5" stop-color="#333947" />
      <stop offset="1" stop-color="#191c23" />
    </linearGradient>
    <linearGradient id="hf-sheen" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff2c8" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff2c8" stop-opacity="0.5" />
      <stop offset="1" stop-color="#fff2c8" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="hf-halo" cx="0.5" cy="0.45" r="0.55">
      <stop offset="0" stop-color="#f5c542" stop-opacity="0.42" />
      <stop offset="0.6" stop-color="#c08552" stop-opacity="0.12" />
      <stop offset="1" stop-color="#c08552" stop-opacity="0" />
    </radialGradient>
    <filter id="hf-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="13" />
    </filter>

    <path id="hf-feather" d="M0 0 C 40 -18 92 -24 122 -8 C 88 4 38 8 0 0 Z" />

    <g id="hf-wing">
      {
        TIERS.map((tier) => (
          <g opacity={tier.opacity}>
            {Array.from({ length: tier.count }, (_, i) => {
              const t = i / (tier.count - 1);
              const angle = tier.start - tier.spread * t;
              const len = tier.scale * (1 - tier.taper * t);
              return (
                <use
                  href="#hf-feather"
                  transform={`rotate(${angle}) translate(${tier.base} 0) scale(${len})`}
                />
              );
            })}
          </g>
        ))
      }
      <path d="M-24 48 Q 4 -6 20 -52 Q 34 -34 24 -2 Q 12 30 -6 54 Z" opacity="0.9" />
    </g>

    <g id="hf-dumbbell">
      <rect x="-64" y="-6" width="128" height="12" rx="6" />
      <rect x="-72" y="-30" width="18" height="60" rx="7" />
      <rect x="-50" y="-23" width="13" height="46" rx="6" />
      <rect x="54" y="-30" width="18" height="60" rx="7" />
      <rect x="37" y="-23" width="13" height="46" rx="6" />
    </g>

    <g id="hf-body">
      <!-- Wings behind the torso, fanning out and up from the shoulder line -->
      <use href="#hf-wing" transform="translate(452 268)" fill="url(#hf-bronze)"></use>
      <g transform="translate(400 0) scale(-1 1) translate(-400 0)">
        <use href="#hf-wing" transform="translate(452 268)" fill="url(#hf-bronze)"></use>
      </g>

      <!-- Arms drawn as stroked limbs so the silhouette keeps negative space -->
      <g
        stroke="url(#hf-marble)"
        stroke-width="34"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      >
        <path d="M348 280 L 296 352 L 272 430"></path>
        <path d="M452 280 L 504 352 L 528 430"></path>
      </g>

      <g fill="url(#hf-marble)">
        <!-- Head, neck, laurel and head-wings -->
        <circle cx="400" cy="172" r="34"></circle>
        <path d="M386 198 L 414 198 L 420 244 L 380 244 Z"></path>

        <!-- Torso: flat shoulder line, chest, lat taper to waist, wrap below -->
        <path
          d="M400 246
             C 364 246 342 254 334 268
             C 324 288 326 304 334 316
             C 346 334 352 360 356 392
             C 360 424 366 444 376 456
             L 424 456
             C 434 444 440 424 444 392
             C 448 360 454 334 466 316
             C 474 304 476 288 466 268
             C 458 254 436 246 400 246 Z"
        ></path>

        <!-- Wrap / skirt -->
        <path
          d="M368 448 Q 400 462 432 448 L 442 500 Q 400 522 358 500 Z"
          opacity="0.95"
        ></path>

        <!-- Fists -->
        <circle cx="272" cy="436" r="22"></circle>
        <circle cx="528" cy="436" r="22"></circle>

        <use href="#hf-dumbbell" transform="translate(272 452)"></use>
        <use href="#hf-dumbbell" transform="translate(528 452)"></use>

        <!-- Plinth -->
        <path d="M354 510 L 446 510 L 460 570 L 340 570 Z"></path>
      </g>
      <rect x="348" y="504" width="104" height="7" rx="3" fill="url(#hf-bronze)"></rect>

      <!-- Laurel band -->
      <path
        d="M400 132 C 427 132 443 151 445 174 L 431 170 C 423 153 412 146 400 146 C 388 146 377 153 369 170 L 355 174 C 357 151 373 132 400 132 Z"
        fill="url(#hf-bronze)"
      ></path>
    </g>

    <clipPath id="hf-clip">
      <rect x="60" y="80" width="680" height="540" />
    </clipPath>
  </defs>

  <ellipse class="hf-halo" cx="400" cy="300" rx="330" ry="250" fill="url(#hf-halo)"></ellipse>

  <g class="hf-float">
    <use class="hf-aura" href="#hf-body" filter="url(#hf-glow)" opacity="0.35"></use>
    <use href="#hf-body"></use>
    <g clip-path="url(#hf-clip)" style="mix-blend-mode: soft-light;">
      <rect class="hf-shimmer" x="-560" y="60" width="240" height="560" fill="url(#hf-sheen)"></rect>
    </g>
  </g>
</svg>

<style>
  .hero-figure {
    width: 100%;
    height: auto;
    display: block;
  }

  .hf-float {
    animation: hf-float 12s ease-in-out infinite;
  }

  .hf-halo {
    animation: hf-breathe 7s ease-in-out infinite;
    transform-origin: 400px 300px;
  }

  .hf-aura {
    animation: hf-aura 7s ease-in-out infinite;
  }

  .hf-shimmer {
    transform: skewX(-18deg);
    animation: hf-sweep 9s ease-in-out infinite;
  }

  @keyframes hf-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  @keyframes hf-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.05);
    }
  }

  @keyframes hf-aura {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.5;
    }
  }

  @keyframes hf-sweep {
    0%,
    55% {
      transform: skewX(-18deg) translateX(0);
    }
    85%,
    100% {
      transform: skewX(-18deg) translateX(1560px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-float,
    .hf-halo,
    .hf-aura,
    .hf-shimmer {
      animation: none;
    }
  }
</style>
