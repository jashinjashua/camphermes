---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ranks } from "../lib/scoring";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/site/about-*.jpg", {
  eager: true,
});

function rankImage(name: string): ImageMetadata | null {
  const entry = Object.entries(images).find(([path]) => path.includes(`${name}.jpg`));
  return entry ? entry[1].default : null;
}
---

<section class="section section-alt" id="classes">
  <div class="container">
    <div class="section-header reveal">
      <h2>Camp classes</h2>
      <p class="lead">
        For each camp level, there are specific physical exercises and minimum repetitions you must
        be able to complete before applying. Smoking, alcohol, drugs, chips, and soda are
        prohibited.
      </p>
      <p class="lead">
        Make sure you can complete the required numbers for the level you're interested in. Then
        click Apply and contact our team. The
        <a href="/rank/" class="text-link">Hero Rank Test</a> tells you where you stand.
      </p>
    </div>

    <div class="rank-track" role="list">
      {
        ranks.map((rank) => {
          const image = rankImage(rank.image);
          return (
            <article
              class:list={["rank-card", `rank-${rank.letter.toLowerCase()}`, { locked: rank.locked }]}
              role="listitem"
            >
              {image && (
                <div class="rank-media">
                  <Image
                    src={image}
                    alt={rank.level ? `Level ${rank.level}` : "Level X"}
                    widths={[320, 480]}
                    sizes="(max-width: 600px) 80vw, 320px"
                  />
                  <span class="rank-letter">{rank.letter}</span>
                </div>
              )}
              <div class="rank-body">
                <h3>
                  {rank.locked ? `${rank.letter}-Class` : `${rank.letter}-Class · ${rank.name}`}
                  <span class="rank-name">{rank.level ? `Level ${rank.level}` : "???"}</span>
                </h3>
                <ul>
                  {rank.requirements.map((req) => (
                    <li>{req.text}</li>
                  ))}
                </ul>
                <a href="/#contact" class="text-link">
                  Apply →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .rank-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 300px;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 4px 20px;
    margin-top: 24px;
  }

  .rank-card {
    scroll-snap-align: start;
    background: var(--bg);
    border: 1px solid var(--border);
    border-top: 3px solid var(--rank-color);
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .rank-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }

  .rank-card.locked {
    opacity: 0.85;
  }

  .rank-media {
    position: relative;
  }

  .rank-media img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .rank-card.locked .rank-media img {
    filter: grayscale(1) brightness(0.6);
  }

  .rank-letter {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-family: var(--font-display);
    font-size: 2.6rem;
    color: var(--rank-color);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  }

  .rank-body {
    padding: 18px 20px 22px;
  }

  .rank-body h3 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 14px;
  }

  .rank-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--rank-color);
  }

  .rank-body ul {
    list-style: none;
    display: grid;
    gap: 7px;
    margin-bottom: 16px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .rank-body li::before {
    content: "— ";
    color: var(--rank-color);
  }
</style>
